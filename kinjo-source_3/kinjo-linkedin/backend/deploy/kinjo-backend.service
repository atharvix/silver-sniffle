[Unit]
Description=Kinjo backend (Go, LinkedIn auth + Postgres + WebSocket)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# Create a dedicated unprivileged user: sudo useradd -r -s /usr/sbin/nologin kinjo
User=kinjo
EnvironmentFile=/etc/kinjo-backend.env
ExecStart=/usr/local/bin/kinjo-backend
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
