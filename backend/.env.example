# Copy to .env and fill in. Never commit the real .env.
PORT=8080

# Postgres connection string for the NEW Kinjo database (not Firebase).
# e.g. postgres://kinjo:secret@127.0.0.1:5432/kinjo?sslmode=disable
DATABASE_URL=

# Where to send the user back after LinkedIn sign-in.
# Android app (bundled web UI): the deep link the app registers.
FRONTEND_URL=kinjo://auth
# If you also serve a website, use its origin instead, e.g. https://app.kinjo.example

# Origins allowed to call the API / open the WebSocket (comma-separated).
# The app's webview origins: Android https://localhost, iPhone capacitor://localhost. Add the admin
# site's origin here too (e.g. the Vite dev server or where you host kinjo-site).
ALLOW_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173

# Admin panel: shared secret for /admin/* API. If unset, the admin API is OFF.
# The kinjo-site /admin page asks for this and sends it as X-Admin-Token.
ADMIN_TOKEN=
# Encrypts stored credentials (Apple refresh tokens) at rest: openssl rand -base64 32
# Keep it with the other secrets; losing it makes those values unreadable.
DATA_KEY=

# App Review demo account (optional, set both). This address signs in with the fixed
# 6-digit code below (no email is sent) and always sees three sample cards.
DEMO_EMAIL=
DEMO_CODE=

# LinkedIn "Sign In with LinkedIn using OpenID Connect" app credentials.
# Create an app at https://www.linkedin.com/developers/apps and add the
# "Sign In with LinkedIn using OpenID Connect" product.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URL on the LinkedIn app. This is the
# BACKEND callback (LinkedIn requires https), NOT the deep link:
LINKEDIN_REDIRECT_URL=https://your-backend-host/auth/linkedin/callback

# Optional: "Continue with Google". Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → type "Web application"; authorised redirect URI:
#   https://your-backend-host/auth/google/callback   (same origin as LINKEDIN_REDIRECT_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for verification-link emails. If unset, the backend logs the
# link instead of sending it (fine for development). You can reuse the SMTP
# account from CREDENTIALS_AND_OPS.md.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Kinjo <no-reply@your-domain>

# Optional FCM (Firebase Cloud Messaging) for background push to closed apps.
# This is the push transport only — not Firebase Auth/Firestore. Create a
# Firebase project, enable Cloud Messaging, download a service-account key, and
# point one of these at it. The app must register its FCM token via /api/device.
# FCM_PROJECT_ID=your-fcm-project-id
# FCM_CREDENTIALS_FILE=/etc/kinjo-fcm-service-account.json
# or inline instead of a file:
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}


# Optional: iPhone location pushes (Location Push Service Extension, LOCATION_PUSH=1 in
# ios-build.sh). Needs Apple's com.apple.developer.location.push entitlement. A .p8 APNs
# auth key (developer.apple.com → Keys; the one uploaded to Firebase works). Token auth only.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY_FILE=/etc/kinjo-apns-AuthKey.p8     (or APNS_KEY_P8 with the PEM text)
# APNS_BUNDLE_ID=com.kinjo.app
# APNS_SANDBOX=1      only for builds run from Xcode; TestFlight/App Store are production

# Sign in with Apple (iPhone). Sign-in itself needs nothing here. To revoke Apple's grant when
# someone deletes their account (App Store rule), add a key with "Sign in with Apple" enabled
# (developer.apple.com → Keys; it can be the same key as APNs if both services are ticked):
# APPLE_SIGNIN_KEY_ID=
# APPLE_SIGNIN_KEY_FILE=/etc/kinjo-apple-AuthKey.p8   (or APPLE_SIGNIN_KEY_P8 with the PEM text)
# APPLE_TEAM_ID=        falls back to APNS_TEAM_ID
# APPLE_BUNDLE_ID=com.kinjo.app
