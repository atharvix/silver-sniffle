# Kinjo API — matches production (/etc/systemd/system/kinjo.service).
# Diff against the server before replacing it.
[Unit]
Description=Kinjo API (Go)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
WorkingDirectory=/var/www/kinjo-app/backend
EnvironmentFile=/var/www/kinjo-app/backend/.env
ExecStart=/var/www/kinjo-app/backend/kinjo-api
Restart=always
RestartSec=2
# Graceful shutdown: the server drains HTTP for up to 10 s on SIGTERM.
TimeoutStopSec=15
# Recommended: run unprivileged (useradd -r kinjo; chown -R kinjo /var/www/kinjo-app/backend).
#User=kinjo
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
